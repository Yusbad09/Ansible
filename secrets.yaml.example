# vars/secrets.yaml
# ─────────────────────────────────────────────────────────────────
# IMPORTANT: This file must be encrypted with Ansible Vault before
# committing to any version control system.
#
# To encrypt:   ansible-vault encrypt vars/secrets.yaml
# To edit:      ansible-vault edit vars/secrets.yaml
# To decrypt:   ansible-vault decrypt vars/secrets.yaml
# ─────────────────────────────────────────────────────────────────

# Palo Alto Firewall
vault_firewall_ip: "YOUR_FIREWALL_IP"          # e.g. 10.0.0.1
vault_api_key: "YOUR_PANOS_API_KEY"            # Generated from PAN-OS

# SMB Share credentials
vault_smb_share: "//YOUR_SERVER_IP/ShareName"  # e.g. //192.168.1.100/Backups
vault_smb_user: "DOMAIN\\username"             # e.g. corp\\svc_backup
vault_smb_password: "YOUR_SMB_PASSWORD"
vault_smb_remote_path: "Backups/PaloAlto/2024" # Remote folder path
